# Caimón — production deploy configuration (non-secret).
#
# This file is sourced by BOTH the local half of the pipeline (start.prod.sh,
# which zips + uploads) and the cloud half (start_pipeline.sh and the .tools
# scripts it runs). Secrets never live here — they go in .env.production at the
# repo root, which start.prod.sh ships alongside the code and start_pipeline.sh
# sources on the host for `docker stack deploy` variable substitution.
#
# Replaces the old `crossx` stack (crossx.raidpr.com) on the same swarm host.

STACK_NAME="caimon"
DOMAIN_NAME="caimon.raidpr.com"
APP_ROUTER="caimon_web"
API_ROUTER="caimon_api"
URL_NAME="https://caimon.raidpr.com"

# Where the build lands on the cloud host: ${CLOUD_PATH}${DOMAIN_PATH_PREFIX}.
# The old stack used /apps/crossx under the same root.
DOMAIN_PATH_PREFIX="/apps/caimon"

# Two images are built (web SPA served by nginx + Fastify API). Each build gets
# a unique tag (base:BUILD_TAG, computed in start_pipeline.sh) so `docker stack
# deploy` sees a new image reference and performs a rolling update — a fixed tag
# makes Swarm skip the restart even though the code changed, which is why the
# old crossx flow had to `docker stack rm` the whole stack first.
DOCKER_IMAGE_WEB_BASE="localhost:5005/caimon_web"
DOCKER_IMAGE_API_BASE="localhost:5005/caimon_api"
# Only the prod compose file exists — local development runs on the host via
# `pnpm dev:up`, not as a swarm stack. DOCKER_COMPOSE_DEV is kept for symmetry
# with the other RaidX pipelines; start_pipeline.sh refuses `dev` outright.
DOCKER_COMPOSE_DEV="caimon.development.yml"
DOCKER_COMPOSE_PROD="caimon.production.yml"

# Pre-deploy Postgres dumps land here on the cloud host, rotated to the newest
# BACKUP_KEEP. Deliberately OUTSIDE the per-build extract dir so clean.prod.sh
# never touches it.
BACKUP_DIR="/root/dev/caimon-backups"
BACKUP_KEEP=10
DB_USER="caimon"
DB_NAME="caimon"

# Cloud host (same swarm that ran crossx).
SSH_KEY="D:\dev\raidpr\apps\_keys/raidpr_com_cloud_key"
CLOUD_PATH="/root/dev/raidpr.com"
CLOUD_USER="root"
CLOUD_HOST="89.117.17.43"

SHARED_PATH=".docker/.tools/raidx"
DOCKER_PATH=".docker"
TOOLS_PATH=".docker/.tools"
SCRIPTS_INCLUDE="lib.sh"
