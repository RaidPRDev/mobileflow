# Caimón production secrets / runtime config.
#
#   cp .docker/.env.production.example .env.production
#
# Keep it at the WORKSPACE ROOT (it is gitignored via `.env.*`). start.prod.sh
# ships it with the build; start_pipeline.sh sources it on the cloud host so
# `docker stack deploy` can substitute these into .docker/caimon.production.yml.
# Every ${VAR} the stack file references must exist here — an unset one
# substitutes to an empty string and the api container fails its env check at
# boot (which the healthcheck catches, and the deploy rolls back).

# ─── Database ────────────────────────────────────────────────────────────────
# Used for both POSTGRES_PASSWORD and the api's DATABASE_URL. Changing it after
# the first deploy does NOT change the password inside the existing volume —
# rotate it in Postgres first, then here.
CAIMON_DB_PASSWORD=

# ─── App secrets ─────────────────────────────────────────────────────────────
# 32+ bytes. `openssl rand -hex 32`. env.ts rejects placeholder-looking values
# in production, so don't ship "change-me...".
CAIMON_COOKIE_SECRET=
# Exactly 32 bytes hex (64 chars): `openssl rand -hex 32`. Encrypts OAuth
# tokens, environment-variable values and certificate blobs at rest. Rotating it
# makes previously stored ciphertext unreadable.
CAIMON_TOKEN_ENC_KEY=

# X-Forwarded-* trust. Requests reach the API as Traefik → web(nginx) → api, so
# the peer is the nginx container on the caimon-network overlay, not loopback.
# Name that subnet (docker network inspect caimon_caimon-network) or list the
# nginx task IP. Never "true": env.ts refuses to start with it in production.
CAIMON_TRUST_PROXY=10.0.0.0/8

# Host directory bind-mounted read-only at /keys in the api container. Put the
# build-host private keys there (chmod 600) and point the *_SSH_KEY_PATH vars
# below at /keys/<filename>.
CAIMON_KEYS_DIR=/root/dev/caimon-keys

# ─── Bootstrap accounts (applied by db:seed on every boot) ───────────────────
SUPERADMIN_EMAIL=
# >= 12 chars; production refuses to boot with a shorter one when the email is set.
SUPERADMIN_PASSWORD=
TESTERCLIENT_EMAIL=
TESTERCLIENT_PASSWORD=

# ─── OAuth (blank disables a provider) ───────────────────────────────────────
# Redirect URIs at the provider must point at
# https://caimon.raidpr.com/api/auth/oauth/<provider>/callback
# (and .../git/<provider>/callback for git connections).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_GIT_CLIENT_ID=
GITHUB_GIT_CLIENT_SECRET=

# ─── Linux build host (Android + Web) ────────────────────────────────────────
# Leave LINUX_BUILD_HOST empty to keep the stub runner.
LINUX_BUILD_HOST=
LINUX_BUILD_PORT=22
LINUX_BUILD_USER=root
# Path INSIDE the api container — i.e. under /keys (see CAIMON_KEYS_DIR).
LINUX_BUILD_SSH_KEY_PATH=/keys/linux_build_key
LINUX_BUILD_REMOTE_BASE=/root/RaidX/Clients
LINUX_BUILD_DOWNLOADS_BASE=/root/RaidX/downloads
LINUX_BUILD_DOWNLOADS_BASE_URL=https://xbuilds.raidpr.com
LINUX_BUILD_ANDROID_IMAGE=raidx-android-builder:latest
LINUX_BUILD_ANDROID_TOOLS=/root/RaidX/Tools/android

# ─── Mac build host (iOS) ────────────────────────────────────────────────────
# Leave MAC_BUILD_HOST empty to keep the stub runner. Key auth only.
MAC_BUILD_HOST=
MAC_BUILD_PORT=22
MAC_BUILD_USER=
MAC_BUILD_SSH_KEY_PATH=/keys/mac_build_key
MAC_BUILD_REMOTE_BASE=/Users/build/RaidX/Clients
MAC_BUILD_DOWNLOADS_BASE=/Users/build/RaidX/downloads
MAC_BUILD_DOWNLOADS_BASE_URL=https://xbuilds.raidpr.com
MAC_BUILD_TOOLS=/Users/build/RaidX/Tools
