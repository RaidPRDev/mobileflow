# Caimón web SPA — built with rspack, served by nginx.
# Built from the monorepo root as the build context.

# ---- build stage ----
FROM node:20-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@8.15.6 --activate

# All manifests: pnpm validates the whole workspace against the lockfile before
# the filter narrows the install.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/docs/package.json apps/docs/
COPY apps/desktop/package.json apps/desktop/
# NODE_ENV is deliberately unset here: rspack and its loaders are
# devDependencies, and a production install would skip them.
RUN pnpm install --frozen-lockfile --filter @mobileflow/web...

COPY packages/shared packages/shared
COPY packages/ui packages/ui
COPY apps/web apps/web
# Monorepo-root assets the SPA imports (LoginPage provider icons, admin payment
# processor icons via the @assets alias). They live above apps/web, so they have
# to be copied explicitly.
COPY assets assets

# NODE_ENV drives rspack's isDev switch: without it the bundle ships unminified,
# with unhashed filenames and react-refresh wired in.
RUN NODE_ENV=production pnpm --filter @mobileflow/web build

# ---- serve stage ----
FROM nginx:1.27-alpine
COPY .docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
